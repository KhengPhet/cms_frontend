# On Vercel, set VITE_API_URL as an environment variable
# in project settings BEFORE building.
# Do NOT include "/api" here — api.js appends it automatically.
# Example: VITE_API_URL=https://your-backend.up.railway.app
#
# This file is the fallback for local production builds only.
VITE_API_URL=https://cms-api-production.up.railway.app
